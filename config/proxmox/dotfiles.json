{
    "dotfiles": [
        {
            "source": "~/.config",
            "destination": ".config",
            "type": "dir"
        },
        {
            "source": "~/.bashrc",
            "destination": ".bashrc",
            "type": "file"
        },
        {
            "source": "~/.bash_aliases",
            "destination": ".bash_aliases",
            "type": "file"
        },
        {
            "source": "~/scripts",
            "destination": "scripts",
            "type": "dir"
        }
    ]
}